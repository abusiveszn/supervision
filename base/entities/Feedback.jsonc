{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "supervisor_id": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "ai_suggestions": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted"
      ],
      "default": "submitted"
    }
  },
  "required": [
    "document_id",
    "content"
  ]
}